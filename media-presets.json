{
  "schema": 1,
  "presets": [
    {
      "id": "slide-up",
      "name": "Slide Up",
      "category": "Motion",
      "family": "Media Motion",
      "description": "Owned Transform Position offset in layer-space pixels. Native layout stays intact; visible distance follows native scale/rotation.",
      "parameters": [
        {
          "key": "distance",
          "label": "Distance \u00b7 layer pixels",
          "type": "number",
          "min": 0,
          "max": 10000,
          "step": 1,
          "default": 120
        },
        {
          "key": "duration",
          "label": "Duration \u00b7 seconds",
          "type": "number",
          "min": 0.05,
          "max": 120,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "easing",
          "label": "Easing",
          "type": "select",
          "options": [
            "linear",
            "ease-in",
            "ease-out",
            "easy"
          ],
          "default": "easy"
        }
      ]
    },
    {
