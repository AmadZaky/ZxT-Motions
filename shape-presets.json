{
  "schema": 1,
  "presets": [
    {
      "id": "trim-in",
      "name": "Trim Path In",
      "category": "Motion",
      "family": "Shape Motion",
      "description": "Reveals a stroked path with an owned Trim Paths operator. Select a path group in AE when several groups exist. Filled artwork remains visible.",
      "parameters": [
        {
          "key": "duration",
          "label": "Duration · seconds",
          "type": "number",
          "min": 0.05,
          "max": 120,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "easing",
          "label": "Easing",
          "type": "select",
          "options": ["linear", "ease-in", "ease-out", "easy"],
          "default": "easy"
        }
      ]
    },
    {
      "id": "path-wiggle",
      "name": "Path Wiggle",
      "category": "Motion",
      "family": "Shape Motion",
      "description": "Adds an owned native Wiggle Paths operator to one path group. Motion starts at the Apply playhead.",
      "parameters": [
        {
          "key": "amount",
          "label": "Amount · pixels",
          "type": "number",
          "min": 0,
          "max": 500,
          "step": 1,
          "default": 10
        },
        {
          "key": "detail",
          "label": "Detail",
          "type": "number",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "default": 3
        },
        {
          "key": "speed",
          "label": "Speed · wiggles/sec",
          "type": "number",
          "min": 0,
          "max": 20,
          "step": 0.1,
          "default": 1
        }
      ]
    },
    {
      "id": "glow",
      "name": "Glow",
      "category": "FX",
      "family": "Shape FX",
      "description": "Adds one owned native Glow effect without changing existing effects or shape artwork.",
      "parameters": [
        {
          "key": "intensity",
          "label": "Intensity",
          "type": "number",
          "min": 0,
          "max": 10,
          "step": 0.1,
          "default": 1
        },
        {
          "key": "radius",
          "label": "Radius · pixels",
          "type": "number",
          "min": 0,
          "max": 500,
          "step": 1,
          "default": 25
        },
        {
          "key": "threshold",
          "label": "Threshold · %",
          "type": "number",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 60
        }
      ]
    },
    {
      "id": "blur-pulse",
      "name": "Blur Pulse",
      "category": "FX",
      "family": "Shape FX",
      "description": "Adds a finite Gaussian blur pulse from the Apply playhead. Returns to zero at the end and preserves artwork.",
      "parameters": [
        {
          "key": "amount",
          "label": "Peak blur · pixels",
          "type": "number",
          "min": 0,
          "max": 500,
          "step": 1,
          "default": 20
        },
        {
          "key": "duration",
          "label": "Duration · seconds",
          "type": "number",
          "min": 0.05,
          "max": 120,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "easing",
          "label": "Easing",
          "type": "select",
          "options": ["linear", "ease-in", "ease-out", "easy"],
          "default": "easy"
        }
      ]
    }
  ]
}
