        {
          "key": "duration",
          "label": "Duration · seconds",
          "type": "number",
          "min": 0.05,
          "max": 120,
          "step": 0.05,
          "default": 1
        },
        {
          "key": "easing",
          "label": "Easing",
          "type": "select",
          "options": [
            "linear",
            "ease-in",
            "ease-out",
            "easy"
          ],
          "default": "easy"
        }
      ]
    },
    {
      "id": "gaussian-blur",
      "name": "Gaussian Blur",
      "category": "FX",
      "family": "Shape FX",
